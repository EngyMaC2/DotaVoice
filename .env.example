# ---- Сервис DotaVoice ----
DOTAVOICE_HOST=0.0.0.0
DOTAVOICE_PORT=12000
# Общий секрет; должен совпадать с токеном "auth" в конфиге GSI.
DOTAVOICE_GSI_TOKEN=
# Хранилище: "memory" (по умолчанию) или "redis"
DOTAVOICE_STORE=memory
DOTAVOICE_REDIS_URL=redis://localhost:6379/0
# Голосовой бэкенд: "memory" (по умолчанию) или "discord"
DOTAVOICE_VOICE=memory
# Сколько хранится завершённый матч, чтобы клиент мог переподключиться (секунды)
DOTAVOICE_SESSION_GRACE_SECONDS=900
# Уровень логирования
DOTAVOICE_LOG_LEVEL=INFO

# ---- Голосовой бэкенд Discord (только при DOTAVOICE_VOICE=discord) ----
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# JSON-словарь: игрок в игре -> id пользователя Discord, например
# {"12345":"111111111111111111","PlayerName":"222222222222222222"}
DISCORD_USER_MAP={}

# ---- Необязательный слой рассуждений LLM ----
# Оставьте LLM_API_KEY незаданным, чтобы агент работал детерминированно (без вызовов LLM).
LLM_MODEL=gpt-4.1
LLM_API_KEY=
LLM_BASE_URL=
