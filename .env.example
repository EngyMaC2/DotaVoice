# ---- Сервис DotaVoice ----
DOTAVOICE_HOST=0.0.0.0
DOTAVOICE_PORT=12000
# Общий секрет; должен совпадать с токеном "auth" в конфиге GSI.
DOTAVOICE_GSI_TOKEN=
# Хранилище: "memory" (по умолчанию) или "redis"
DOTAVOICE_STORE=memory
DOTAVOICE_REDIS_URL=redis://localhost:6379/0
# Голосовой бэкенд: "relay" (встроенный голосовой сервер), "p2p" (напрямую между
# игроками, шифрование end-to-end, без сервера), "memory" (только состояние) или "discord"
DOTAVOICE_VOICE=relay
# Адрес внешнего голосового сервера (пусто = встроенный на DOTAVOICE_PORT, UDP)
DOTAVOICE_VOICE_RELAY_URL=
# Отображаемое имя в голосовом канале
DOTAVOICE_DISPLAY_NAME=
# ---- P2P-голос (только при DOTAVOICE_VOICE=p2p) ----
# Multicast-группа для поиска участников в локальной сети (пусто = значение по умолчанию)
DOTAVOICE_P2P_GROUP=
# Транспорт Steam SDR. По умолчанию выключен: включение использует Steamworks и
# подчиняется правилам Valve (см. docs/security.md). Не включайте без понимания риска.
DOTAVOICE_P2P_STEAM_SDR=0

# ---- Обновления ----
# Версия сборки и публичный ключ Ed25519 для проверки подписанных манифестов
DOTAVOICE_VERSION=0.2.0
DOTAVOICE_UPDATE_PUBLIC_KEY=

# Устройства звука (пусто = системные по умолчанию)
DOTAVOICE_INPUT_DEVICE=
DOTAVOICE_OUTPUT_DEVICE=
# Сколько хранится завершённый матч, чтобы клиент мог переподключиться (секунды)
DOTAVOICE_SESSION_GRACE_SECONDS=900
# Уровень логирования
DOTAVOICE_LOG_LEVEL=INFO

# ---- Голосовой бэкенд Discord (только при DOTAVOICE_VOICE=discord) ----
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# JSON-словарь: игрок в игре -> id пользователя Discord, например
# {"12345":"111111111111111111","PlayerName":"222222222222222222"}
DISCORD_USER_MAP={}

# ---- Необязательный слой рассуждений LLM ----
# Оставьте LLM_API_KEY незаданным, чтобы агент работал детерминированно (без вызовов LLM).
LLM_MODEL=gpt-4.1
LLM_API_KEY=
LLM_BASE_URL=
