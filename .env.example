# ---- DotaVoice service ----
DOTAVOICE_HOST=0.0.0.0
DOTAVOICE_PORT=12000
# Shared secret; must match the "auth" token in the GSI config file.
DOTAVOICE_GSI_TOKEN=
# Store backend: "memory" (default) or "redis"
DOTAVOICE_STORE=memory
DOTAVOICE_REDIS_URL=redis://localhost:6379/0
# Voice backend: "memory" (default) or "discord"
DOTAVOICE_VOICE=memory
# How long an ended match is kept so a client restart can re-attach (seconds)
DOTAVOICE_SESSION_GRACE_SECONDS=900
# Log level
DOTAVOICE_LOG_LEVEL=INFO

# ---- Discord voice backend (only when DOTAVOICE_VOICE=discord) ----
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# JSON map of game player -> Discord user id, e.g.
# {"12345":"111111111111111111","PlayerName":"222222222222222222"}
DISCORD_USER_MAP={}

# ---- Optional LLM reasoning layer ----
# Leave LLM_API_KEY unset to run the agent deterministically (no LLM calls).
LLM_MODEL=gpt-4.1
LLM_API_KEY=
LLM_BASE_URL=
